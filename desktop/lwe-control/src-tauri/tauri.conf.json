{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LWE Control",
  "version": "0.1.0",
  "identifier": "nl.localwebsiteeditor.control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LWE Control",
        "width": 700,
        "height": 720,
        "minWidth": 620,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
