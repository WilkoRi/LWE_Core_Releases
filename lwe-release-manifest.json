{
  "schemaVersion": 1,
  "releaseChannel": "stable",
  "versionFile": "lwe-process/version.json",
  "managedFiles": [
    "server.js",
    "lcb/editor.js",
    "lcb/lcb-editor.css",
    "scripts/lwe-next.js",
    "scripts/lwe-approve-build.js",
    "scripts/lwe-reset.js",
    "scripts/lwe-images.js",
    "scripts/lwe-publish-check.js",
    "scripts/lwe-rules.js",
    "scripts/lwe-update.js",
    "scripts/lwe-update-check.js",
    "scripts/lwe-update-install.js",
    "scripts/lwe-control-desktop-release-macos.js",
    "lwe-image.config.json",
    "lwe-release-manifest.json",
    "lwe-process/process.json",
    "lwe-process/version.json",
    "lwe/filters/calendar.js",
    "lwe/filters/text.cjs",
    "LCB-AI-INSTRUCTIES.md",
    "AI_START_HERE.md",
    "MANUAL.md",
    "MANUAL.en.md",
    "MANUAL.de.md",
    "manual_images/*",
    "lcb-context/*",
    "desktop/lwe-control/.gitignore",
    "desktop/lwe-control/README.md",
    "desktop/lwe-control/index.html",
    "desktop/lwe-control/package-lock.json",
    "desktop/lwe-control/package.json",
    "desktop/lwe-control/src-tauri/Cargo.lock",
    "desktop/lwe-control/src-tauri/Cargo.toml",
    "desktop/lwe-control/src-tauri/build.rs",
    "desktop/lwe-control/src-tauri/icons/icon.icns",
    "desktop/lwe-control/src-tauri/icons/icon.png",
    "desktop/lwe-control/src-tauri/src/main.rs",
    "desktop/lwe-control/src-tauri/tauri.conf.json",
    "desktop/lwe-control/src/main.js",
    "desktop/lwe-control/src/styles.css",
    "src/assets/system.css",
    "src/assets/system-calendar.js",
    ".vscode/extensions/*"
  ],
  "mergeOnly": [
    "package.json",
    "lcb.config.json",
    ".eleventyignore",
    ".vscode/extensions.json"
  ],
  "neverOverwrite": [
    "src/_data/**",
    "src/**/*.njk",
    "src/**/*.html",
    "src/assets/styles.css",
    "_site/**",
    "node_modules/**",
    "desktop/lwe-control/dist/**",
    "desktop/lwe-control/node_modules/**",
    "desktop/lwe-control/src-tauri/gen/**",
    "desktop/lwe-control/src-tauri/target/**",
    "desktop/lwe-control/src-tauri/icons/icon.iconset/**",
    "release-assets/**",
    "_includes/**",
    "_data/**",
    "assets/css/**",
    "project-input/**",
    "lwe-process/state.json",
    ".env",
    ".htaccess"
  ],
  "notes": [
    "Projectcontent en projectspecifieke templates worden niet automatisch overschreven.",
    "_site/ mag in Core bestaan als demo-output, maar wordt nooit naar bestaande projecten geupdate.",
    "node_modules/ wordt nooit door LWE updates beheerd of overschreven.",
    "desktop/lwe-control/ bronbestanden mogen naar projecten worden uitgerold; gegenereerde build-output en dependencies nooit.",
    "Gebruik alleen GitHub Releases; nooit rechtstreeks main.",
    "Maak altijd een backup voordat bestanden worden vervangen."
  ]
}
